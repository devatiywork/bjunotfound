generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  password        String
  roleId          String      @default("user")
  gender          Gender
  birthDate       DateTime
  height          Int // в см
  formulaType     FormulaType @default(MIFFLIN_ST_JEOR) // формула расчета калорий
  activityLevelId String      @default("sedentary") // уровень активности
  timezone        String      @default("UTC") // часовой пояс пользователя
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  weights       Weight[]
  goals         Goal[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  productsUser  ProductUser[] // пользовательские продукты
  activityLevel ActivityLevel  @relation(fields: [activityLevelId], references: [id])
  role          UserRole       @relation(fields: [roleId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ActivityLevel {
  id          String @id // sedentary, light, moderate, active, very_active
  name        String @unique
  description String
  coefficient Float // коэффициент для расчета TDEE

  users User[]

  @@map("activity_levels")
}

model UserRole {
  id          String   @id // user, admin
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users User[]

  @@map("user_roles")
}

model CalorieSetting {
  id          String   @id @default(uuid())
  key         String   @unique // min_calories_female, max_deficit, pace_moderate, etc.
  value       Float
  category    String // safety_limits, pace_options, scientific
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("calorie_settings")
}

model Weight {
  id     String   @id @default(uuid())
  userId String
  weight Float
  date   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weights")
}

model Goal {
  id                   String     @id @default(uuid())
  userId               String
  initialWeight        Float? // вес на момент создания цели
  targetWeight         Float?
  targetCalories       Int?
  targetSteps          Int? // целевое количество шагов в день
  targetBurnedCalories Float? // целевые сожженные калории в день
  startDate            DateTime   @default(now())
  endDate              DateTime?
  isActive             Boolean    @default(true)
  status               GoalStatus @default(IN_PROGRESS)
  isArchived           Boolean    @default(false)
  deletedAt            DateTime?
  deletedBy            String?
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum FormulaType {
  MIFFLIN_ST_JEOR // Миффлина-Сан Жеора (рекомендуется)
  HARRIS_BENEDICT
}

model ActivityLog {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date // дата без времени (YYYY-MM-DD)
  recordedAt       DateTime @default(now()) // когда была создана запись
  steps            Int      @default(0) // суммарное количество шагов за день
  burnedCalories   Float    @default(0) // сожженные калории за день
  consumedCalories Float? // потребленные калории (опционально, из meal plans)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[] // детальные записи активностей за день

  @@unique([userId, date]) // одна запись на дату для пользователя
  @@map("activity_logs")
}

model Activity {
  id              String       @id @default(uuid())
  activityLogId   String
  type            ActivityType @default(WALKING)
  steps           Int // шаги в этой активности
  burnedCalories  Float // калории этой активности
  durationMinutes Int? // длительность в минутах (опционально)
  notes           String? // заметки пользователя
  performedAt     DateTime     @default(now()) // когда выполнена активность
  createdAt       DateTime     @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum ActivityType {
  WALKING // обычная ходьба (~0.04 ккал/шаг/кг)
  FAST_WALKING // быстрая ходьба (~0.06 ккал/шаг/кг)
  RUNNING // бег (~0.09 ккал/шаг/кг)
  CUSTOM // пользовательская активность
}

// ============================================
// НОВАЯ СИСТЕМА ПРОДУКТОВ
// ============================================

enum Language {
  RU
  EN
  UK
  ES
  FR
  DE
}

enum Currency {
  RUB
  USD
  EUR
  UAH
  KZT
}

// 1. Категории продуктов (справочник, заполняется админом)
model Category {
  id        String   @id @default(uuid())
  parentId  String? // для дерева категорий
  name      String // название категории
  slug      String   @unique // строковый ключ для URL
  photos    String[] @default([]) // фотографии категории (массив URL)
  isActive  Boolean  @default(true) // включена ли категория
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryTree")
  productsGlobal ProductGlobal[]
  productsUser   ProductUser[]

  @@map("categories")
}

// 2. Бренды (справочник)
model Brand {
  id             String   @id @default(uuid())
  name           String // отображаемое имя
  normalizedName String   @unique // для дедупликации (lowercase, no spaces)
  country        String? // страна бренда
  photos         String[] @default([]) // логотипы/фото бренда (массив URL)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productsGlobal ProductGlobal[]
  productsUser   ProductUser[]

  @@map("brands")
}

// 3. Глобальный продукт (канонический, общий для всех)
model ProductGlobal {
  id         String   @id @default(uuid())
  barcode    String?  @unique // штрихкод EAN/UPC (nullable для развесных)
  categoryId String
  brandId    String?
  country    String? // страна происхождения
  photos     String[] @default([]) // фотографии продукта (массив URL)
  isVerified Boolean  @default(false) // подтверждён модерацией/AI
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand     Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  names     ProductGlobalI18n[] // названия на разных языках
  nutrition NutritionGlobalPer100? // БЖУ на 100г
  usersRefs ProductUser[] // ссылки от пользовательских продуктов

  @@map("products_global")
}

// 4. Названия глобального продукта на разных языках
model ProductGlobalI18n {
  id              String   @id @default(uuid())
  productGlobalId String
  lang            Language // язык
  name            String // название на этом языке

  productGlobal ProductGlobal @relation(fields: [productGlobalId], references: [id], onDelete: Cascade)

  @@unique([productGlobalId, lang]) // один язык = одно название
  @@map("products_global_i18n")
}

// 5. Пищевая ценность глобального продукта (на 100г)
model NutritionGlobalPer100 {
  productGlobalId String   @id // PK и FK одновременно (связь 1:1)
  caloriesKcal    Float // калории на 100г
  proteinsG       Float // белки на 100г
  fatsG           Float // жиры на 100г
  carbohydratesG  Float // углеводы на 100г
  sugarsG         Float? // сахара
  fiberG          Float? // клетчатка
  saltG           Float? // соль
  updatedAt       DateTime @updatedAt

  productGlobal ProductGlobal @relation(fields: [productGlobalId], references: [id], onDelete: Cascade)

  @@map("nutrition_global_per_100")
}

// 6. Пользовательский продукт (личная карточка)
model ProductUser {
  id              String   @id @default(uuid())
  userId          String // владелец продукта
  productGlobalId String? // связь с глобальным продуктом (если найден)
  barcode         String? // штрихкод (если введён, но global ещё не создан)
  categoryId      String?
  brandId         String?
  photos          String[] @default([]) // фотографии продукта (массив URL)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  productGlobal ProductGlobal?       @relation(fields: [productGlobalId], references: [id], onDelete: SetNull)
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  names         ProductUserI18n[] // названия с языком ввода
  nutrition     NutritionUserPer100? // БЖУ на 100г
  packages      ProductUserPackage[] // покупки/упаковки
  servings      ProductUserServing[] // порции

  @@map("products_user")
}

// 7. Названия пользовательского продукта + язык ввода
model ProductUserI18n {
  id            String   @id @default(uuid())
  productUserId String
  lang          Language // язык (определяется автоматически)
  name          String // название, введённое пользователем

  productUser ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  @@unique([productUserId, lang]) // один язык = одно название
  @@map("products_user_i18n")
}

// 8. Пищевая ценность пользовательского продукта (на 100г)
model NutritionUserPer100 {
  productUserId  String   @id // PK и FK одновременно (связь 1:1)
  caloriesKcal   Float // калории на 100г
  proteinsG      Float // белки на 100г
  fatsG          Float // жиры на 100г
  carbohydratesG Float // углеводы на 100г
  sugarsG        Float? // сахара
  fiberG         Float? // клетчатка
  saltG          Float? // соль
  updatedAt      DateTime @updatedAt

  productUser ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  @@map("nutrition_user_per_100")
}

// 9. Упаковки/покупки (история покупок продукта)
model ProductUserPackage {
  id            String    @id @default(uuid())
  productUserId String
  totalWeightG  Float? // общий вес упаковки в граммах
  totalVolumeMl Float? // общий объём в миллилитрах
  priceTotal    Float // цена за упаковку
  currency      Currency // валюта
  purchasedAt   DateTime? // когда купил
  store         String? // магазин
  note          String? // заметка
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  productUser ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  @@map("product_user_packages")
}

// 10. Порции (пользовательские размеры порций)
model ProductUserServing {
  id            String   @id @default(uuid())
  productUserId String
  name          String // название порции ("ломтик", "яйцо", "ложка")
  amountUnits   Float    @default(1) // количество штук в порции
  weightG       Float? // сколько грамм в сумме
  volumeMl      Float? // сколько мл (если жидкость)
  isDefault     Boolean  @default(false) // порция по умолчанию
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productUser ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  @@map("product_user_servings")
}
